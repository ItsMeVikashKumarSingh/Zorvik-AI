# ========================================================================
# ZORVIK AI MICROSERVICE ENVIRONMENT CONFIGURATION (.env)
# ========================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://zorviktech.com,https://www.zorviktech.com,https://zorvik.tech,https://studio.zorvik.tech

# Zero-Cost Model Providers ($0 Tier)
# 1. Google Gemini AI Studio (Primary) - https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Groq Cloud (Fallback 1 - Ultra Fast 500+ tok/s) - https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter Free (Fallback 2) - https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Dedicated Supabase AI Database (PostgreSQL + pgvector + Auth)
AI_SUPABASE_URL=https://your-dedicated-ai-project.supabase.co
AI_SUPABASE_ANON_KEY=your_dedicated_ai_anon_key_here
AI_SUPABASE_SERVICE_ROLE_KEY=your_dedicated_ai_service_role_key_here

# Upstash Redis (Hot In-Memory Sliding Window & Edge Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Rate Limiting & Defaults
DEFAULT_TENANT_RATE_LIMIT=60
GUEST_RATE_LIMIT=30
